<?xml version="1.0" encoding="utf-8"?>

<!-- CONTENEDOR SCROLL DEL DETALLE -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:orientation="vertical">

        <!-- INDICADOR SUPERIOR DEL MODAL -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@color/card_border" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Detalle del Gasto"
            android:textColor="@color/texto_negro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- TARJETA DE LA FOTO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <!-- IMAGEN DEL TICKET -->
            <ImageView
                android:id="@+id/ivFotoTicket"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_sin_foto" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTONES DE FOTO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEliminarFoto"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar Foto"
                android:textColor="@color/error_red" />

            <Button
                android:id="@+id/btnCambiarFoto"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar Foto"
                android:textColor="@color/link_azul" />

        </LinearLayout>

        <!-- CAMPO TÍTULO -->
        <EditText
            android:id="@+id/etTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="center"
            android:hint="Título del gasto"
            android:inputType="textCapSentences"
            android:padding="8dp"
            android:textColor="@color/texto_negro"
            android:textColorHint="@color/text_body_light"
            android:textSize="18sp" />

        <!-- BLOQUE IMPORTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etImporteDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:textColor="@color/texto_negro"
                android:textColorHint="@color/text_body_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" €"
                android:textColor="@color/texto_negro"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CAMPO DESCRIPCIÓN -->
        <EditText
            android:id="@+id/etDescripcionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:hint="Descripción del gasto"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:textColor="@color/texto_negro"
            android:textColorHint="@color/texto_negro"
            android:textSize="16sp" />

        <!-- BOTONES DE ACCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnEliminarGasto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/error_red"
                android:text="Eliminar"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnGuardarCambios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/rosa_cerdito"
                android:text="Guardar"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- ESPACIO INFERIOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>