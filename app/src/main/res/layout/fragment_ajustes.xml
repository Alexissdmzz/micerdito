<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="AJUSTES"
            android:textColor="@color/texto_negro"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <!-- SECCIÓN CUENTA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Mi Cuenta"
            android:textAllCaps="true"
            android:textColor="@color/texto_negro"
            android:textSize="12sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:importantForAccessibility="noHideDescendants">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:text="👤 Cambiar nombre de usuario"
                    android:textColor="@color/texto_negro"
                    android:textSize="16sp"
                    android:contentDescription="Botón, Cambiar nombre de usuario" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/card_background"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/btnBorrarCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:text="🗑️ Borrar cuenta"
                    android:textColor="#E53935"
                    android:textSize="16sp"
                    android:contentDescription="Botón, Borrar cuenta permanentemente" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN APARIENCIA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Apariencia"
            android:textAllCaps="true"
            android:textColor="@color/texto_negro"
            android:textSize="12sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:focusable="true"
                    android:contentDescription="Opción para activar o desactivar Modo Oscuro">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌙 Modo Oscuro"
                        android:textColor="@color/texto_negro"
                        android:textSize="16sp"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Modo Oscuro" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LOGOUT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp"
                android:text="🚪 Cerrar Sesión"
                android:textColor="#E53935"
                android:textSize="16sp"
                android:textStyle="bold"
                android:contentDescription="Botón, Cerrar sesión de la aplicación" />
        </com.google.android.material.card.MaterialCardView>

        <!-- VERSIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Versión 1.0.0 - MiCerdito 🐷"
            android:textColor="@color/texto_negro"
            android:textSize="12sp"
            android:contentDescription="Versión de la aplicación 1.0.0 Mi Cerdito" />

    </LinearLayout>
</ScrollView>