<?xml version="1.0" encoding="utf-8"?>

<!-- CONTENEDOR PRINCIPAL CON SCROLL -->
<!-- Permite desplazamiento vertical para consultar el resumen mensual, el gráfico y los últimos movimientos -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige"
    android:importantForAccessibility="yes">

    <!-- CONTENEDOR VERTICAL PRINCIPAL -->
    <!-- Organiza en columna el resumen mensual, la distribución de gastos y la lista de movimientos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TARJETA DE RESUMEN MENSUAL -->
        <!-- Muestra el mes actual, el total gastado, el estado del límite y el acceso para configurarlo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="Resumen de gastos mensuales"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:screenReaderFocusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <!-- CONTENIDO INTERNO DEL RESUMEN -->
            <!-- Agrupa verticalmente la información principal del gasto mensual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TEXTO DEL MES ACTUAL -->
                <!-- Indica el periodo mensual al que corresponde el resumen mostrado -->
                <TextView
                    android:id="@+id/tvMesActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_semibold"
                    android:textColor="@color/texto_negro"
                    android:textSize="14sp" />

                <!-- TEXTO DEL TOTAL GASTADO -->
                <!-- Muestra la cantidad total gastada durante el mes actual -->
                <TextView
                    android:id="@+id/tvTotalSpent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_semibold"
                    android:textColor="@color/texto_negro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- TEXTO DEL ESTADO DEL LÍMITE -->
                <!-- Informa al usuario sobre la situación actual respecto al límite de gasto -->
                <TextView
                    android:id="@+id/tvLimitStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_semibold"
                    android:textColor="@color/texto_negro"
                    android:textSize="14sp" />

                <!-- ENLACE PARA ESTABLECER LÍMITE -->
                <!-- Permite al usuario configurar o modificar el límite mensual de gasto -->
                <TextView
                    android:id="@+id/tvEstablecerLimite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:clickable="true"
                    android:contentDescription="Botón, establecer límite de gasto mensual"
                    android:focusable="true"
                    android:fontFamily="@font/amiko_semibold"
                    android:importantForAccessibility="yes"
                    android:text="Establecer límite"
                    android:textColor="@color/link_azul"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO DE DISTRIBUCIÓN -->
        <!-- Introduce la sección del gráfico con la distribución de gastos por categoría -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/amiko_semibold"
            android:importantForAccessibility="yes"
            android:text="Distribución de gastos"
            android:textColor="@color/texto_negro"
            android:textStyle="bold" />

        <!-- TARJETA DEL GRÁFICO -->
        <!-- Contiene la visualización circular del reparto de gastos por categoría -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Gráfico circular mostrando el porcentaje de gastos por categoría"
            android:focusable="true"
            android:importantForAccessibility="yes"
            app:cardCornerRadius="16dp">

            <!-- GRÁFICO CIRCULAR DE GASTOS -->
            <!-- Representa visualmente el porcentaje de gasto en cada categoría -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/graficoCircular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_background"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO DE ÚLTIMOS MOVIMIENTOS -->
        <!-- Introduce la sección con el listado de transacciones recientes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/amiko_semibold"
            android:importantForAccessibility="yes"
            android:text="Últimos movimientos"
            android:textColor="@color/texto_negro"
            android:textStyle="bold" />

        <!-- LISTA DE GASTOS RECIENTES -->
        <!-- Muestra al usuario las transacciones o movimientos registrados más recientemente -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Lista de transacciones recientes"
            android:importantForAccessibility="yes"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_gastos" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>