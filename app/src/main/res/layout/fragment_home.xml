<?xml version="1.0" encoding="utf-8"?>

<!-- CONTENEDOR PRINCIPAL SCROLL -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige"
    android:importantForAccessibility="yes">

    <!-- CONTENEDOR VERTICAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TARJETA RESUMEN MENSUAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="Resumen de gastos mensuales"
            android:focusable="true"
            android:screenReaderFocusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <!-- CONTENIDO DE LA TARJETA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- MES ACTUAL -->
                <TextView
                    android:id="@+id/tvMesActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_negro"
                    android:textSize="14sp" />

                <!-- TOTAL GASTADO -->
                <TextView
                    android:id="@+id/tvTotalSpent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_negro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- ESTADO DEL LÍMITE -->
                <TextView
                    android:id="@+id/tvLimitStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_negro"
                    android:textSize="14sp" />

                <!-- ENLACE PARA ESTABLECER LÍMITE -->
                <TextView
                    android:id="@+id/tvEstablecerLimite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Establecer límite"
                    android:textColor="@color/link_azul"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO DISTRIBUCIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="Distribución de gastos"
            android:textColor="@color/texto_negro"
            android:textStyle="bold" />

        <!-- TARJETA GRÁFICO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Gráfico circular mostrando el porcentaje de gastos por categoría"
            android:focusable="true"
            app:cardCornerRadius="16dp">

            <!-- GRÁFICO CIRCULAR -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/graficoCircular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_background"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO LISTA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="Últimos movimientos"
            android:textColor="@color/texto_negro"
            android:textStyle="bold" />

        <!-- LISTA DE GASTOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Lista de transacciones recientes"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_gastos" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>