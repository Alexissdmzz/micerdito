<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/micerdito_welcome"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBackForgotPwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Regresar a la pantalla anterior"
            android:focusable="true"
            android:fontFamily="@font/amiko_semibold"
            android:padding="8dp"
            android:text="&lt; Atrás"
            android:textColor="@color/texto_negro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitleForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/amiko_semibold"
            android:gravity="center"
            android:text="RECUPERAR\nCONTRASEÑA"
            android:textColor="@color/texto_negro"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBackForgotPwd" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="ejemplo@correo.com"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="@color/texto_negro"
            app:layout_constraintTop_toBottomOf="@id/tvTitleForgot">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiko_semibold"
                android:inputType="textEmailAddress"
                android:textColor="@color/texto_negro" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvPreguntaSeguridad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@color/background_beige"
            android:contentDescription="Pregunta de seguridad recuperada: Introduce tu correo para verla"
            android:fontFamily="@font/amiko_semibold"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Introduce tu correo para ver la pregunta"
            android:textColor="@color/texto_negro"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tilEmail" />

        <LinearLayout
            android:id="@+id/layoutNuevaPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvPreguntaSeguridad"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRespuesta"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Escribe la respuesta aquí"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="@color/texto_negro">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRespuestaSeguridad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_semibold"
                    android:textColor="@color/texto_negro" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNuevaPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nueva contraseña"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="@color/texto_negro"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNuevaPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko_semibold"
                    android:inputType="textPassword"
                    android:textColor="@color/texto_negro" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/rosa_cerdito"
            android:fontFamily="@font/amiko_semibold"
            android:text="VERIFICAR"
            android:textAllCaps="true"
            android:textColor="@color/texto_negro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutNuevaPass"
            app:layout_constraintVertical_bias="0.0"
            app:strokeColor="#000000"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>