<?xml version="1.0" encoding="utf-8"?>

<!-- TARJETA DE GASTO DEL DÍA -->
<!-- Representa un gasto individual mostrando categoría, título, hora e importe -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:contentDescription="Elemento de gasto"
    android:focusable="true"
    android:importantForAccessibility="yes"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <!-- CONTENEDOR INTERNO -->
    <!-- Organiza horizontalmente el icono, la información del gasto y el importe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ICONO DE CATEGORÍA -->
        <!-- Muestra un icono representativo del tipo de gasto -->
        <TextView
            android:id="@+id/tvIconoCat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:fontFamily="@font/amiko_semibold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="20sp" />

        <!-- CONTENEDOR DE INFORMACIÓN -->
        <!-- Agrupa el título del gasto y la hora en la que se realizó -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <!-- TÍTULO DEL GASTO -->
            <!-- Indica el concepto o nombre del gasto -->
            <TextView
                android:id="@+id/tvTituloGasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiko_semibold"
                android:textColor="@color/texto_negro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- HORA DEL GASTO -->
            <!-- Muestra la hora en la que se registró el gasto -->
            <TextView
                android:id="@+id/tvHoraGasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiko_semibold"
                android:textColor="@color/texto_negro"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- IMPORTE DEL GASTO -->
        <!-- Indica la cantidad económica del gasto -->
        <TextView
            android:id="@+id/tvImporteGasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiko_semibold"
            android:importantForAccessibility="no"
            android:textColor="@color/error_red"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>