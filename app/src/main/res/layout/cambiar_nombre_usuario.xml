<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:importantForAccessibility="yes"
    android:screenReaderFocusable="false">

    <!-- TEXTO DESCRIPTIVO DEL CAMPO -->
    <!-- Informa al usuario que debe ingresar un nuevo nombre de usuario -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingrese el nuevo nombre de usuario:"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/texto_negro"
        android:labelFor="@+id/etNuevoNombre"
        android:fontFamily="@font/amiko_semibold"
        android:importantForAccessibility="yes"
        android:accessibilityHeading="true" />

    <!-- CAMPO DE ENTRADA DEL NUEVO NOMBRE -->
    <!-- Permite al usuario escribir el nuevo nombre de usuario con soporte para TalkBack -->
    <EditText
        android:id="@+id/etNuevoNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribe aquí..."
        android:textColor="@color/texto_negro"
        android:textColorHint="@color/texto_negro"
        android:inputType="textPersonName"
        android:layout_marginTop="10dp"
        android:contentDescription="Campo para ingresar el nuevo nombre de usuario"
        android:importantForAccessibility="yes"
        android:fontFamily="@font/amiko_semibold"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>