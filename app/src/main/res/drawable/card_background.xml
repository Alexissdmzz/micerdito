<?xml version="1.0" encoding="utf-8"?>

<!-- FONDO DE TARJETAS -->
<!-- Define el estilo visual de los contenedores en toda la app -->

<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- COLOR DE FONDO -->
    <!-- Cambia automáticamente en modo claro (blanco) y oscuro (azul oscuro) -->
    <solid android:color="@color/card_background" />

    <!-- BORDE EXTERIOR -->
    <!-- Línea para separar visualmente las tarjetas del fondo -->
    <stroke
        android:width="1.5dp"
        android:color="@color/card_border" />

    <!-- ESQUINAS REDONDEADAS -->
    <corners android:radius="16dp" />

    <!-- ESPACIADO INTERNO -->
    <!-- Evita que el contenido quede pegado a los bordes -->
    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />

</shape>